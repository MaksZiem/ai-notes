# Konfiguracja środowiska testowego (staging). Skopiuj do frontend/.env.staging i zbuduj przez `npm run build:staging`.
# VITE_* są wstawiane do plików JS przy buildzie, po zmianie trzeba zbudować frontend ponownie.

# Publiczny adres backendu testowego (https, przez reverse proxy)
VITE_API_URL=https://api.ai-notes-test.zmax-dev.pl
# Publiczny adres Hocuspocus środowiska testowego (wss, przez reverse proxy)
VITE_YJS_URL=wss://api.ai-notes-test.zmax-dev.pl/collab
