# Konfiguracja produkcyjna. Skopiuj do frontend/.env.production przed `npm run build`.
# VITE_* są wstawiane do plików JS przy buildzie, po zmianie trzeba zbudować frontend ponownie.

# Publiczny adres backendu (https, przez reverse proxy)
VITE_API_URL=https://notes-api.example.com
# Publiczny adres Hocuspocus (wss, przez reverse proxy)
VITE_YJS_URL=wss://notes-api.example.com/collab
