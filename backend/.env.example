# Lokalny development. Skopiuj do backend/.env.

PORT=3001
# Port serwera Hocuspocus (wspólna edycja notatek, WebSocket)
YJS_PORT=1234
# Adres frontendu (CORS, linki w mailach)
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASS=
DB_NAME=ai_notes
# true = TypeORM sam dopasowuje schemat do encji (tylko lokalnie, nigdy na produkcji).
# Domyślnie schemat tworzą migracje: npm run migration:run
DB_SYNCHRONIZE=false

# Katalog na obrazki wgrywane do notatek (domyślnie ./uploads)
UPLOAD_DIR=uploads

# Dowolny długi losowy ciąg, np. openssl rand -hex 32
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
RESEND_API_KEY=
