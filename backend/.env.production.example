# Konfiguracja produkcyjna. Na serwerze skopiuj do .env obok docker-compose.yml i uzupełnij.
# Prawdziwego pliku nie commituj.

NODE_ENV=production
# Porty tylko na localhost, ruch przychodzi przez reverse proxy
PORT=3001
YJS_PORT=1234
# Publiczny adres frontendu (CORS, linki w mailach)
FRONTEND_URL=https://ai-notes.zmax-dev.pl

# Postgres w Dockerze zakłada bazę i użytkownika z tych wartości.
# DB_HOST i DB_PORT nadpisuje docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_notes
DB_PASS=
DB_NAME=ai_notes
# Na produkcji zawsze false, schemat tworzą migracje
DB_SYNCHRONIZE=false


# openssl rand -hex 32
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Domena nadawcy (zmax-dev.pl) musi być zweryfikowana w Resend
RESEND_API_KEY=
# Dzienny limit wywołań AI na użytkownika (chroni limit Gemini, także na koncie demo)
AI_DAILY_LIMIT_PER_USER=30

# Docker Compose na serwerze
# Wersje obrazów z GHCR: latest albo sha commita
BACKEND_TAG=latest
FRONTEND_TAG=latest
# Porty na 127.0.0.1, na które Caddy przekazuje ruch (inne dla każdej aplikacji i środowiska)
FRONTEND_PORT=3010
BACKEND_PORT=3011
COLLAB_PORT=3012
