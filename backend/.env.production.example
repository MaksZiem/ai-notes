# Konfiguracja produkcyjna. Na serwerze skopiuj do backend/.env i uzupełnij.
# Prawdziwego pliku nie commituj.

NODE_ENV=production
# Porty tylko na localhost, ruch przychodzi przez reverse proxy
PORT=3001
YJS_PORT=1234
# Publiczny adres frontendu (CORS, linki w mailach)
FRONTEND_URL=https://notes.example.com

# Bazę i użytkownika zakładasz na serwerze (DEPLOY.md)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_notes
DB_PASS=
DB_NAME=ai_notes
# Na produkcji zawsze false, schemat tworzą migracje
DB_SYNCHRONIZE=false

# Katalog poza folderem z kodem, żeby wdrożenie go nie nadpisało. Uwzględnij go w backupach.
UPLOAD_DIR=/var/lib/ai-notes/uploads

# openssl rand -hex 32
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Domena nadawcy (zmax-dev.pl) musi być zweryfikowana w Resend
RESEND_API_KEY=
