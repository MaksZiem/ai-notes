# Konfiguracja środowiska testowego (staging). Na serwerze skopiuj do backend/.env kopii testowej i uzupełnij.
# Sekrety, baza i katalog uploadów inne niż na produkcji. Prawdziwego pliku nie commituj.

NODE_ENV=production
# Porty tylko na localhost, ruch przychodzi przez reverse proxy
PORT=3001
YJS_PORT=1234
# Publiczny adres frontendu testowego (CORS, origin WebSocketów, linki w mailach)
FRONTEND_URL=https://ai-notes-test.zmax-dev.pl

# Osobna baza i użytkownik dla testu (DEPLOY.md)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_notes_test
DB_PASS=
DB_NAME=ai_notes_test
# Zawsze false, schemat tworzą migracje
DB_SYNCHRONIZE=false

# Osobny katalog, żeby obrazki z testu nie mieszały się z produkcyjnymi
UPLOAD_DIR=/var/lib/ai-notes-test/uploads

# openssl rand -hex 32, inny niż na produkcji
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Domena nadawcy (zmax-dev.pl) musi być zweryfikowana w Resend
RESEND_API_KEY=
